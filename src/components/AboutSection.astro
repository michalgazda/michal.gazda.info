---
import type { Language } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const skills = [
  { key: 'java', level: 90 },
  { key: 'aws', level: 80 },
  { key: 'k8s', level: 70 },
  { key: 'other', level: 80 },
];
---

<section id="about" class="about-area pt-125 pb-130">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="section-title text-center">
          <h2 class="title">{t('about.title')}</h2>
          <p>{t('about.desc')}</p>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-lg-6">
        <div class="about-content mt-50">
          <h5 class="about-title">{t('about.subtitle')}</h5>
          <p>{t('about.desc')}</p>
          <ul class="clearfix">
            <li>
              <div class="single-info d-flex align-items-center">
                <div class="info-icon">
                  <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="info-text">
                  <p><span>{t('about.location')}</span> {t('about.location_val')}</p>
                </div>
              </div>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-xl-5 offset-xl-1 col-lg-6">
        <div class="about-skills pt-25">
          {skills.map((s) => (
            <div class="skill-item mt-25">
              <div class="skill-header">
                <h6 class="skill-title">{t(`skill.${s.key}` as any)}</h6>
                <div class="skill-percentage">
                  <div class="count-box counted">
                    <span class="counter">{s.level}</span>
                  </div>
                  %
                </div>
              </div>
              <div class="skill-bar">
                <div class="bar-inner">
                  <div class="bar progress-line" data-width={s.level}></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
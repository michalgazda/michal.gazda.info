---
import type { Language } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
---

<footer id="footer" class="footer-area">
  <div class="footer-widget pt-130 pb-130">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="footer-content text-center">
            <p class="mt-0"></p>
            <ul>
              <li><a href="https://www.linkedin.com/in/micha%C5%82-gazda-90877620/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a></li>
              <li><a href="https://github.com/michalgazda" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fab fa-github"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-copyright pb-20">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="copyright-text text-center pt-20">
            <p>{t('footer.copyright')} {t('footer.author')}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>
---
import type { Language } from '../i18n';
import { useTranslations, languages } from '../i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;
const alternateLang = lang === 'pl' ? 'en' : 'pl';
const homePath = lang === 'pl' ? base : `${base}en/`;

const links = [
  { href: homePath, label: t('nav.home') },
  { href: `${base}#about`, label: t('nav.about') },
  { href: `${base}#contact`, label: t('nav.contact') },
];
---

<header id="home" class="header-area">
  <div class="navigation fixed-top">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <nav class="navbar navbar-expand-lg">
            <a class="navbar-brand" href={homePath}>
              <img src={`${base}assets/images/logo_small.png`} alt={t('hero.title')} />
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
              aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
              <span class="toggler-icon"></span>
              <span class="toggler-icon"></span>
              <span class="toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
              <ul class="navbar-nav ml-auto">
                {links.map((l) => (
                  <li class="nav-item"><a class="page-scroll" href={l.href}>{l.label}</a></li>
                ))}
                <li class="nav-item">
                  <a class="page-scroll lang-switch" href={lang === 'pl' ? `${base}en/` : base}>
                    {t('lang.label')}
                  </a>
                </li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .lang-switch {
    font-weight: 700 !important;
    padding: 0 8px;
    border: 2px solid #754ef9;
    border-radius: 4px;
    color: #754ef9 !important;
  }
  .lang-switch::before {
    display: none !important;
  }
  .lang-switch:hover {
    background: #754ef9;
    color: #fff !important;
  }
</style>